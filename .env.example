# Development defaults are built in for localhost only. Override these before
# exposing the relay outside this computer.
FLEET_APP_TOKEN=change-me-app-token
FLEET_DAEMON_TOKEN=change-me-daemon-token
FLEET_RELAY_URL=ws://127.0.0.1:4317/ws/daemon
FLEET_ALLOWED_ROOTS=/absolute/path/to/your/projects
FLEET_RELAY_HOST=127.0.0.1
FLEET_RELAY_PORT=4317
FLEET_STATE_DIR=.local/state
FLEET_MACHINE_NAME=My-Mac

# Off by default. Turn on only for local end-to-end smoke tests or if you
# intentionally want a raw managed shell alongside coding-agent harnesses.
FLEET_ENABLE_SHELL=0
